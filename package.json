    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "postcss": "8.5.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "overrides": {
