# Copie este arquivo para `.env` e preencha com a URL do seu banco.
#
# Na Vercel: painel do projeto → Storage → seu banco Postgres → mostra a
# DATABASE_URL. Ou, com a CLI instalada, rode `npx vercel env pull .env`.
DATABASE_URL="postgresql://usuario:senha@servidor:5432/lexflow?sslmode=require"

# IA (Fase 5) — chave da API do Claude, criada em https://console.anthropic.com
# Sem ela, a tela de Minutas funciona em modo demonstração.
ANTHROPIC_API_KEY=""

# Opcional: troca o modelo do redator de minutas (padrão: claude-opus-4-8).
# MODELO_IA="claude-opus-4-8"

# Opcional: chave da API Pública do DataJud/CNJ. O código já traz a chave
# pública documentada pelo CNJ; defina esta variável se o CNJ trocá-la.
# Docs: https://datajud-wiki.cnj.jus.br/api-publica/
# DATAJUD_API_KEY=""

# DJEN / Diário de Justiça Eletrônico Nacional (Fase 4) — identidade do(a)
# advogado(a) usada para buscar "os meus processos" pela OAB. A tela /djen
# já aceita esses dados no formulário; estas variáveis apenas preenchem os
# campos e servem à busca automática. A API do CNJ só aceita acessos do
# Brasil, por isso a rota roda na região São Paulo (gru1) da Vercel.
ADVOGADO_OAB=""      # só os números, ex.: 12345
ADVOGADO_UF=""       # sigla do estado da OAB, ex.: SP
ADVOGADO_NOME=""     # nome completo, como consta na OAB

# Segredo da varredura automática (cron diário). A rota /api/djen/varrer só
# roda se a Vercel enviar este segredo no cabeçalho Authorization — o que ela
# faz sozinha quando CRON_SECRET existe. Gere um valor aleatório e defina na
# Vercel. O cron dispara todo dia às 11h UTC (08h no horário do Brasil).
CRON_SECRET=""

# Autenticação (Fase 3) — o SUPERADMIN é a plataforma (nós). No primeiro
# login, o sistema cria esse usuário a partir destas variáveis (idempotente).
# Defina um e-mail e uma senha forte na Vercel; depois entre em /entrar com
# eles e cadastre os escritórios no painel /central.
SUPERADMIN_EMAIL=""
SUPERADMIN_SENHA=""
