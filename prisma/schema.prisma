// Modelo de dados do LexFlow — Fase 2.
//
// Cada `model` vira uma tabela no PostgreSQL; cada campo, uma coluna.
// Os nomes em código ficam em português (camelCase) e o @map traduz
// para o padrão do banco (snake_case).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AreaProcesso {
  TRABALHISTA
  CIVEL
  FAMILIA
  TRIBUTARIO
  CRIMINAL
  CONSUMIDOR
  OUTRA
}

enum FaseProcesso {
  CONHECIMENTO
  INSTRUCAO
  SENTENCA
  RECURSAL
  EXECUCAO
  ARQUIVADO
}

model Cliente {
  id        String     @id @default(cuid())
  nome      String
  cpfCnpj   String     @unique @map("cpf_cnpj")
  email     String?
  telefone  String?
  cidade    String?
  criadoEm  DateTime   @default(now()) @map("criado_em")
  processos Processo[]

  @@map("clientes")
}

model Processo {
  id           String       @id @default(cuid())
  numero       String       @unique // numeração única do CNJ
  titulo       String
  area         AreaProcesso
  tribunal     String?
  fase         FaseProcesso @default(CONHECIMENTO)
  ultimoEvento String?      @map("ultimo_evento")
  valorCausa   Decimal?     @map("valor_causa") @db.Decimal(14, 2)
  clienteId    String       @map("cliente_id")
  cliente      Cliente      @relation(fields: [clienteId], references: [id])
  prazos       Prazo[]
  criadoEm     DateTime     @default(now()) @map("criado_em")

  @@map("processos")
}

model Prazo {
  id          String   @id @default(cuid())
  descricao   String
  vencimento  DateTime @db.Date
  responsavel String?
  // Princípio do produto: prazo sugerido (por IA ou não) só entra na
  // agenda oficial depois de validado por um advogado.
  validado    Boolean  @default(false)
  concluido   Boolean  @default(false)
  processoId  String   @map("processo_id")
  processo    Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  criadoEm    DateTime @default(now()) @map("criado_em")

  @@map("prazos")
}

// Comunicações capturadas do DJEN/CNJ pela OAB (Fase 4). Guardamos a
// captura crua do Diário — sem virar Processo ainda, porque um Processo
// exige um Cliente, e o cliente (a parte representada) é uma decisão
// humana. A intimação é a matéria-prima; promovê-la a processo é um
// passo posterior, feito por uma pessoa. `djenId` é a chave de
// deduplicação: a mesma publicação nunca entra duas vezes.
model Intimacao {
  id                   String   @id @default(cuid())
  djenId               String   @unique @map("djen_id")
  numeroProcesso       String   @map("numero_processo")
  tribunal             String?
  tipo                 String?
  orgao                String?
  classe               String?
  resumo               String?  // prévia (para a lista)
  teor                 String?  // teor COMPLETO da publicação
  dataDisponibilizacao String?  @map("data_disponibilizacao") // "AAAA-MM-DD", como o DJEN envia
  oab                  String?
  uf                   String?
  criadoEm             DateTime @default(now()) @map("criado_em")

  @@index([numeroProcesso])
  @@map("intimacoes")
}

// Fase 3 — usuários da equipe do escritório. Por ora é cadastro/gestão
// (nome, e-mail, cargo); o login com senha vem numa etapa seguinte.
model Usuario {
  id          String          @id @default(cuid())
  nome        String
  email       String          @unique
  cargo       String?
  criadoEm    DateTime        @default(now()) @map("criado_em")
  credenciais CredencialOab[]

  @@map("usuarios")
}

// Credencial jurídica (OAB) de um usuário — é o que a varredura automática
// do DJEN usa para puxar "os processos dele". Cada usuário pode ter uma ou
// mais; só as `ativa` entram no cron diário. (numero, uf) é único para não
// cadastrar a mesma OAB duas vezes.
model CredencialOab {
  id           String   @id @default(cuid())
  numero       String // só os dígitos da OAB
  uf           String // sigla do estado, 2 letras
  nomeAdvogado String   @map("nome_advogado")
  ativa        Boolean  @default(true)
  usuarioId    String   @map("usuario_id")
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm     DateTime @default(now()) @map("criado_em")

  @@unique([numero, uf])
  @@map("credenciais_oab")
}
