// Modelo de dados do LexFlow — Fase 2.
//
// Cada `model` vira uma tabela no PostgreSQL; cada campo, uma coluna.
// Os nomes em código ficam em português (camelCase) e o @map traduz
// para o padrão do banco (snake_case).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AreaProcesso {
  TRABALHISTA
  CIVEL
  FAMILIA
  TRIBUTARIO
  CRIMINAL
  CONSUMIDOR
  OUTRA
}

enum FaseProcesso {
  CONHECIMENTO
  INSTRUCAO
  SENTENCA
  RECURSAL
  EXECUCAO
  ARQUIVADO
}

model Cliente {
  id        String     @id @default(cuid())
  nome      String
  cpfCnpj   String     @unique @map("cpf_cnpj")
  email     String?
  telefone  String?
  cidade    String?
  criadoEm  DateTime   @default(now()) @map("criado_em")
  processos Processo[]

  @@map("clientes")
}

model Processo {
  id           String       @id @default(cuid())
  numero       String       @unique // numeração única do CNJ
  titulo       String
  area         AreaProcesso
  tribunal     String?
  fase         FaseProcesso @default(CONHECIMENTO)
  ultimoEvento String?      @map("ultimo_evento")
  valorCausa   Decimal?     @map("valor_causa") @db.Decimal(14, 2)
  clienteId    String       @map("cliente_id")
  cliente      Cliente      @relation(fields: [clienteId], references: [id])
  prazos       Prazo[]
  tarefas      Tarefa[]
  minutas      Minuta[]
  criadoEm     DateTime     @default(now()) @map("criado_em")

  @@map("processos")
}

model Prazo {
  id          String   @id @default(cuid())
  descricao   String
  vencimento  DateTime @db.Date
  responsavel String?
  // Princípio do produto: prazo sugerido (por IA ou não) só entra na
  // agenda oficial depois de validado por um advogado.
  validado    Boolean  @default(false)
  concluido   Boolean  @default(false)
  processoId  String   @map("processo_id")
  processo    Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  criadoEm    DateTime @default(now()) @map("criado_em")

  @@map("prazos")
}

// Comunicações capturadas do DJEN/CNJ pela OAB (Fase 4). Guardamos a
// captura crua do Diário — sem virar Processo ainda, porque um Processo
// exige um Cliente, e o cliente (a parte representada) é uma decisão
// humana. A intimação é a matéria-prima; promovê-la a processo é um
// passo posterior, feito por uma pessoa. `djenId` é a chave de
// deduplicação: a mesma publicação nunca entra duas vezes.
model Intimacao {
  id                   String   @id @default(cuid())
  djenId               String   @unique @map("djen_id")
  numeroProcesso       String   @map("numero_processo")
  tribunal             String?
  tipo                 String?
  orgao                String?
  classe               String?
  resumo               String?  // prévia (para a lista)
  teor                 String?  // teor COMPLETO da publicação
  dataDisponibilizacao String?  @map("data_disponibilizacao") // "AAAA-MM-DD", como o DJEN envia
  oab                  String?
  uf                   String?
  // Dono da captura (o advogado da OAB varrida) — é o que faz "cada um vê
  // só o seu". Nulo nas capturas antigas, anteriores ao isolamento.
  usuarioId            String?  @map("usuario_id")
  usuario              Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  criadoEm             DateTime @default(now()) @map("criado_em")
  // Com quem o dono compartilhou esta publicação (colegas do mesmo Team).
  compartilhamentos    CompartilhamentoIntimacao[]

  @@index([numeroProcesso])
  @@index([usuarioId])
  @@map("intimacoes")
}

// Fase 3 — compartilhamento. O dono de uma intimação pode liberar a leitura
// para um colega do MESMO Team, sem abrir tudo para todos. É só o vínculo
// (quem recebeu); quem compartilhou é sempre o dono da intimação. (intimacao,
// usuario) é único para não compartilhar a mesma publicação duas vezes com a
// mesma pessoa.
model CompartilhamentoIntimacao {
  id          String    @id @default(cuid())
  intimacaoId String    @map("intimacao_id")
  intimacao   Intimacao @relation(fields: [intimacaoId], references: [id], onDelete: Cascade)
  usuarioId   String    @map("usuario_id") // destinatário (quem recebeu o acesso)
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm    DateTime  @default(now()) @map("criado_em")

  @@unique([intimacaoId, usuarioId])
  @@index([usuarioId])
  @@map("compartilhamentos_intimacao")
}

// Fase 3 — papéis de acesso. SUPERADMIN somos nós (a plataforma);
// DONO_ESCRITORIO administra um Team; os demais são a equipe do escritório
// (ASSESSOR/ESTAGIARIO tendem a ser só consulta).
enum PapelUsuario {
  SUPERADMIN
  DONO_ESCRITORIO
  ADVOGADO
  ASSESSOR
  ESTAGIARIO
}

// Team = o escritório/empresa que nos contrata (o inquilino). Tem nome e
// logo próprios (identidade dentro do app). Nós criamos os Teams no painel
// central; cada Team cadastra seus próprios usuários.
model Team {
  id         String              @id @default(cuid())
  nome       String
  logoUrl    String?             @map("logo_url")
  // Número de negócio do WhatsApp deste escritório (id do phone_number_id na
  // Meta). É a chave do roteamento: o webhook liga a conversa recebida ao Team
  // dono deste número. Único — um número pertence a um só escritório.
  whatsappPhoneNumberId String?  @unique @map("whatsapp_phone_number_id")
  criadoEm   DateTime            @default(now()) @map("criado_em")
  usuarios   Usuario[]
  auditorias RegistroAuditoria[]
  conversas  ConversaWhatsapp[]
  modelosWhatsapp ModeloWhatsapp[]
  tarefas    Tarefa[]
  minutas    Minuta[]

  @@map("teams")
}

// Usuário com login (e-mail + senha). Pertence a um Team (exceto o
// SUPERADMIN, que é da plataforma). `senhaHash` guarda o hash (scrypt),
// nunca a senha em texto.
model Usuario {
  id          String          @id @default(cuid())
  nome        String
  email       String          @unique
  senhaHash   String?         @map("senha_hash")
  papel       PapelUsuario    @default(ADVOGADO)
  cargo       String?
  teamId      String?         @map("team_id")
  team        Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  criadoEm    DateTime        @default(now()) @map("criado_em")
  credenciais CredencialOab[]
  sessoes     Sessao[]
  intimacoes  Intimacao[]
  // Publicações que outros donos compartilharam com este usuário.
  intimacoesRecebidas CompartilhamentoIntimacao[]
  auditorias          RegistroAuditoria[]
  conversas           ConversaWhatsapp[]
  tarefas             Tarefa[]

  @@map("usuarios")
}

// Sessão de login — o id é o token que vai no cookie httpOnly. Enquanto
// não expira, identifica o usuário logado.
model Sessao {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime @map("expira_em")
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("sessoes")
}

// Credencial jurídica (OAB) de um usuário — é o que a varredura automática
// do DJEN usa para puxar "os processos dele". Cada usuário pode ter uma ou
// mais; só as `ativa` entram no cron diário. (numero, uf) é único para não
// cadastrar a mesma OAB duas vezes.
model CredencialOab {
  id           String   @id @default(cuid())
  numero       String // só os dígitos da OAB
  uf           String // sigla do estado, 2 letras
  nomeAdvogado String   @map("nome_advogado")
  ativa        Boolean  @default(true)
  usuarioId    String   @map("usuario_id")
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm     DateTime @default(now()) @map("criado_em")

  @@unique([numero, uf])
  @@map("credenciais_oab")
}

// Fase 3 — log de auditoria. Registro append-only de "quem fez o quê, e
// quando". O nome do autor fica gravado (`usuarioNome`) para o log continuar
// legível mesmo se o usuário for removido depois (a FK vira nula, o histórico
// permanece). `teamId` nulo = ação de plataforma (super-admin).
model RegistroAuditoria {
  id          String   @id @default(cuid())
  usuarioId   String?  @map("usuario_id")
  usuario     Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioNome String   @map("usuario_nome") // quem agiu, no momento da ação
  teamId      String?  @map("team_id")
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  acao        String // rótulo curto, ex.: "prazo.validado", "intimacao.compartilhada"
  detalhe     String? // texto legível, ex.: "validou o prazo 'Contestação'"
  criadoEm    DateTime @default(now()) @map("criado_em")

  @@index([teamId, criadoEm])
  @@index([usuarioId])
  @@map("registros_auditoria")
}

// Fase 4 — atendimentos do WhatsApp de verdade. Uma conversa é o fio com UM
// contato (o cliente) num número de negócio (`phoneNumberId`). Chega pelo
// webhook do WhatsApp (Meta Cloud API). `usuarioId`/`teamId` são o dono/roteio
// (nulos enquanto a conversa não foi atribuída) — o isolamento segue o mesmo
// princípio das intimações.
model ConversaWhatsapp {
  id            String             @id @default(cuid())
  telefone      String // E.164 do contato (só dígitos), ex.: "5527998877xxxx"
  nomeContato   String?            @map("nome_contato")
  phoneNumberId String?            @map("phone_number_id") // número de negócio que recebeu
  usuarioId     String?            @map("usuario_id")
  usuario       Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  teamId        String?            @map("team_id")
  team          Team?              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  criadoEm      DateTime           @default(now()) @map("criado_em")
  atualizadoEm  DateTime           @updatedAt @map("atualizado_em")
  mensagens     MensagemWhatsapp[]

  @@unique([telefone, phoneNumberId])
  @@index([teamId])
  @@index([usuarioId])
  @@map("conversas_whatsapp")
}

// Cada mensagem trocada — RECEBIDA (cliente→escritório) ou ENVIADA
// (escritório→cliente). `waMessageId` é o id do WhatsApp e é único: o webhook
// pode reentregar o mesmo evento, então a dedup é do banco.
enum DirecaoMensagem {
  RECEBIDA
  ENVIADA
}

model MensagemWhatsapp {
  id          String           @id @default(cuid())
  conversaId  String           @map("conversa_id")
  conversa    ConversaWhatsapp @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  direcao     DirecaoMensagem
  texto       String
  waMessageId String?          @unique @map("wa_message_id")
  enviadoEm   DateTime         @map("enviado_em") // horário informado pelo WhatsApp
  criadoEm    DateTime         @default(now()) @map("criado_em")

  @@index([conversaId])
  @@map("mensagens_whatsapp")
}

// Fase 4 — modelos (templates) aprovados do WhatsApp. Fora da janela de 24h,
// a Meta só permite enviar mensagens a partir de um MODELO aprovado por ela.
// Aqui o escritório registra os modelos que já aprovou na Meta (nome exato +
// idioma + corpo de referência) para poder dispará-los pela tela. Cada modelo
// é de um Team; (teamId, nome, idioma) é único para não repetir o mesmo.
model ModeloWhatsapp {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  nome      String // nome EXATO aprovado na Meta (ex.: "aviso_de_prazo")
  idioma    String   @default("pt_BR") // código de idioma da Meta
  categoria String? // UTILITY | MARKETING | AUTHENTICATION
  corpo     String // texto de referência do corpo (use {{1}}, {{2}}… nos lugares dos parâmetros)
  numParams Int      @default(0) @map("num_params")
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@unique([teamId, nome, idioma])
  @@index([teamId])
  @@map("modelos_whatsapp")
}

// Situação da tarefa no kanban (as 4 colunas da tela de Tarefas).
enum ColunaTarefa {
  A_FAZER
  EM_ANDAMENTO
  EM_REVISAO
  CONCLUIDA
}

enum PrioridadeTarefa {
  ALTA
  MEDIA
  BAIXA
}

// Tarefa do escritório — o kanban de verdade (antes era demonstração).
// Isolada por Team; pode estar ligada a um Processo e a um responsável
// (usuário do escritório). `ordem` guarda a posição dentro da coluna.
model Tarefa {
  id            String            @id @default(cuid())
  titulo        String
  detalhe       String?
  coluna        ColunaTarefa      @default(A_FAZER)
  prioridade    PrioridadeTarefa?
  ordem         Int               @default(0)
  teamId        String            @map("team_id")
  team          Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  responsavelId String?           @map("responsavel_id")
  responsavel   Usuario?          @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  processoId    String?           @map("processo_id")
  processo      Processo?         @relation(fields: [processoId], references: [id], onDelete: SetNull)
  criadoEm      DateTime          @default(now()) @map("criado_em")
  atualizadoEm  DateTime          @updatedAt @map("atualizado_em")

  @@index([teamId, coluna, ordem])
  @@map("tarefas")
}

// Situação de uma minuta no ciclo do produto: a IA redige, o advogado edita,
// o advogado aprova. Nada é protocolado pelo sistema.
enum StatusMinuta {
  RASCUNHO_IA
  EDITADA
  APROVADA
}

// Minuta (peça) assistida por IA — agora PERSISTIDA (antes o texto sumia ao
// sair da tela). Guarda o rascunho original da IA (`teorIa`) e o texto atual
// (`teor`, que o advogado edita), mais o status. Isolada por Team; ligada a um
// Processo (opcional). O histórico de versões da tela deriva do status.
model Minuta {
  id           String       @id @default(cuid())
  teamId       String       @map("team_id")
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  processoId   String?      @map("processo_id")
  processo     Processo?    @relation(fields: [processoId], references: [id], onDelete: SetNull)
  titulo       String
  teor         String       // texto atual (o advogado edita)
  teorIa       String       @map("teor_ia") // o rascunho original da IA
  status       StatusMinuta @default(RASCUNHO_IA)
  autorNome    String?      @map("autor_nome") // quem gerou/editou por último
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")

  @@index([teamId, atualizadoEm])
  @@map("minutas")
}
